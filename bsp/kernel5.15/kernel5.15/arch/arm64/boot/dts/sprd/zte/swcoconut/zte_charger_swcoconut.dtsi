#include <dt-bindings/usb/pd.h>

/ {
	/*
	 *  bat:haopeng-5200mAh
	 *  bat1:weike-5200mAh
	 *  bat2:reserve-5200mAh
	 *  bat3:reserve-5200mAh
	 *  bat4:reserve-6000mAh
	 *  bat5:reserve-6000mAh
	 *  bat6:weike-6000mAh
	 *  bat7:haopeng-6000mAh
	 */
	bat: battery {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat1: battery1 {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat2: battery2 {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat3: battery3 {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat4: battery4 {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat5: battery5 {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat6: battery6 {
		compatible = "simple-battery";
		status = "disabled";
	};

	bat7: battery7 {
		compatible = "simple-battery";
		status = "disabled";
	};
};

&bat {
	compatible = "simple-battery";
	status = "okay";

	charge-term-current-microamp = <390000>;
	constant-charge-voltage-max-microvolt = <4350000>;
	constant-charge-current-max-microamp = <3400000>;
	factory-internal-resistance-micro-ohms = <99670>;
	voltage-min-design-microvolt = <3450000>;
	fast-charge-threshold-microvolt = <4000000>;
	fullbatt-voltage = <4250000>;
	fullbatt-current = <360000>;
	fullbatt-track-end-vol = <4295000>;
	fullbatt-track-end-cur = <130000>;
	first-calib-voltage = <3659000>;
	first-calib-capacity = <40>;

	ir-cv-offset-microvolt = <100000>;
	ir-rc-micro-ohms = <20000>;
	ir-us-upper-limit-microvolt = <4500000>;

	charge-full-design-microamp-hours = <5200000>;
	/*charge-full-microamp-hours use 5200000 * 0.95 = 4940000*/
	charge-full-microamp-hours = <4940000>;

	ocv-capacity-celsius = <25>;
	ocv-capacity-table-0 = <4303000 100>, <4245700 95>, <4192000 90>,
				<4140600 85>, <4090700 80>, <4051900 75>,
				<3997000 70>, <3970400 65>, <3929800 60>,
				<3875500 55>, <3847300 50>, <3825300 45>,
				<3807900 40>, <3793400 35>, <3779400 30>,
				<3759900 25>, <3742200 20>, <3721400 15>,
				<3693200 10>, <3683000 5>, <3400000 0>;
	voltage-temp-table = <1110270 800>, <999440 850>, <890430 900>,
				<785590 950>, <687630 1000>, <598220 1050>,
				<517680 1100>, <446100 1150>, <383390 1200>,
				<328950 1250>, <281840 1300>, <241480 1350>,
				<207030 1400>, <177580 1450>, <152490 1500>,
				<131160 1550>, <113000 1600>, <97790 1650>;
	capacity-temp-table = <50 99>, <25 100>, <10 100>, <0 94>, <(-10) 59>;
	resistance-temp-table = <50 73>, <25 100>, <10 241>, <0 742>, <(-10) 1106>;

	charge-sdp-current-microamp = <500000 500000>;
	charge-dcp-current-microamp = <3600000 2000000>;
	charge-cdp-current-microamp = <3600000 1500000>;
	charge-unknown-current-microamp = <1000000 1000000>;
	charge-fchg-current-microamp = <3600000 2000000>;

	dcp-jeita-temp-table = <1000 1020 0 4350000>,
				<1100 1120 1000000 4350000>,
				<1150 1180 1000000 4350000>,
				<1450 1420 3600000 4350000>,
				<1550 1520 2600000 4100000>;
	sdp-jeita-temp-table = <1000 1020 0 4350000>,
				<1100 1120 1000000 4350000>,
				<1150 1180 1000000 4350000>,
				<1450 1420 3600000 4350000>,
				<1550 1520 2600000 4100000>;
	cdp-jeita-temp-table = <1000 1020 0 4350000>,
				<1100 1120 1000000 4350000>,
				<1150 1180 1000000 4350000>,
				<1450 1420 3600000 4350000>,
				<1550 1520 2600000 4100000>;
	unknown-jeita-temp-table = <1000 1020 0 4350000>,
				<1100 1120 1000000 4350000>,
				<1150 1180 1000000 4350000>,
				<1450 1420 3600000 4350000>,
				<1550 1520 2600000 4100000>;
	fchg-jeita-temp-table = <1000 1020 0 4350000>,
				<1100 1120 1000000 4350000>,
				<1150 1180 1000000 4350000>,
				<1450 1420 3600000 4350000>,
				<1550 1520 2600000 4100000>;
};

